# deploy/vm -- copy to /opt/purrcare/.env on the VM, fill in, then: chmod 600 .env
# Names only. Real values are generated on the VM (scripts/make-env.sh) and never committed.

# The site address, no scheme: the VM's IP with dashes + .sslip.io until a domain is pointed at it.
SITE_HOST=
# The private Cloud Storage bucket for uploaded files.
GCS_BUCKET=
# The private bucket for nightly database dumps.
BACKUP_BUCKET=

# PostgreSQL superuser (only for setup and backups) and the two roles from deploy/database/roles.sql.
POSTGRES_SUPERUSER_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
REPORTER_DB_PASSWORD=

# Signs the links that serve uploaded files (at least 32 characters).
FILE_URL_SIGNING_KEY=

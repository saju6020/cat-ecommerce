# HO-XCT-001 gate fix 2026-10-12 (SECURITY medium) -- background workers OFF while a restored database is being reconciled.
# Start the application with these variables set (docker run --env-file, a systemd drop-in, or the orchestrator equivalent) until the erasure reapply of
# docs/runbooks/backup-and-restore.md section 5 has run, then restart WITHOUT them. With the workers off no notification is sent to, and no job acts on,
# a customer who was erased after the restore point and has not been re-erased yet. Nothing here is a secret.
Notifications__Worker__Enabled=false
Operations__RetentionWorker__Enabled=false
Clinic__Worker__Enabled=false
Orders__Worker__Enabled=false
Inventory__Worker__Enabled=false
Pharmacy__Worker__Enabled=false
Shop__Worker__Enabled=false

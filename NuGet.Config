<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="brac-package" value="https://gitlab.bracits.com/api/v4/groups/1488/-/packages/nuget/index.json" />
  </packageSources>

  <!--
    Source mapping is REQUIRED, not an optimisation.

    The brac-package feed answers 401 Unauthorized (not 404) for any package it does not host.
    Without mapping, NuGet queries every source for every package, the 401 on a public package
    such as Microsoft.EntityFrameworkCore aborts the whole restore, and the error names the
    public package rather than the feed — which is confusing and costs an afternoon.

    Mapping sends Platform.Infrastructure.* to the private feed and everything else to nuget.org,
    so neither feed is ever asked about a package it does not have.
  -->
  <packageSourceMapping>
    <packageSource key="brac-package">
      <package pattern="Platform.Infrastructure.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    Credentials come from environment variables — NEVER literal values in this file.
    Set BRAC_NUGET_USERNAME and BRAC_NUGET_TOKEN in your environment or secret manager.
    See .ai/new-project-bootstrap.md §1 and SRS NFR-SEC-7.
  -->
  <packageSourceCredentials>
    <brac-package>
      <add key="Username" value="%BRAC_NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%BRAC_NUGET_TOKEN%" />
    </brac-package>
  </packageSourceCredentials>

</configuration>
